# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# uv (lockfile IS committed; cache is not)
.uv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Dagster local artifacts
.dagster/
dagster_home/
tmp*/

# dbt build artifacts (package-lock.yml + uv.lock ARE committed for reproducibility)
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Trained forecasting models (M7). Deliberately NOT committed: CI retrains from scratch each run
# -- seconds at this data size -- so no binary enters the repo and no pickle can go stale against a
# scikit-learn upgrade. Provenance lives in the derived zone, which is where it is queryable.
artifacts/

# Env / secrets
.env
*.local

# OS / editor
.DS_Store
.idea/
.vscode/
